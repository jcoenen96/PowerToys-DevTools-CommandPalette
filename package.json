{
  "name": "devtools-commandpalette-tooling",
  "private": true,
  "description": "Pre-commit tooling only (lint-staged, secretlint, markdownlint); the extension itself is .NET.",
  "scripts": {
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:secrets": "secretlint --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore \"**/*\"",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "lint-staged": "^16.4.0",
    "markdownlint-cli": "^0.47.0",
    "secretlint": "^11.3.1"
  }
}
