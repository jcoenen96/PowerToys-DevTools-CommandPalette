# Editor basics for every file; formatting itself is done by CSharpier (C#).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
# Code style rules checked during the build (EnforceCodeStyleInBuild).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning

# Analyzer rules turned off on purpose:
# CA1848/CA1873: LoggerMessage delegates pay off on hot logging paths; this extension logs a few lines per action.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# CA1711: names like GitCommandCollection describe what the type is.
dotnet_diagnostic.CA1711.severity = none

[tests/**.cs]
# Test names read as sentences: Worktree_head_is_read_from_the_gitdir_file.
dotnet_diagnostic.CA1707.severity = none
# CA1861: inline expected arrays read better in assertions than static fields.
dotnet_diagnostic.CA1861.severity = none

[*.{appxmanifest,manifest,pubxml}]
# Generated by the Command Palette extension template; kept as Visual Studio writes them.
indent_size = unset
